# Gambiarra Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required if using OpenAI provider)
OPENAI_API_KEY=sk-your-api-key-here

# Anthropic API Key (required if using Anthropic provider)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# TrustGraph API Key (optional, for prompt templates)
TRUSTGRAPH_API_KEY=tg-your-api-key-here

# Configuration file path (optional, defaults to ./config.yaml)
GAMBIARRA_CONFIG_FILE=./config.yaml

# Log level override (optional, overrides config.yaml)
GAMBIARRA_LOG_LEVEL=INFO

# Session persistence directory (optional, overrides config.yaml)
GAMBIARRA_SESSION_STORAGE_DIR=~/.cache/gambiarra/sessions

# Transaction backup directory (optional, overrides config.yaml)
GAMBIARRA_TRANSACTION_BACKUP_DIR=~/.cache/gambiarra/transactions

# Rate limiting overrides (optional)
GAMBIARRA_SESSION_REQUESTS_PER_MINUTE=60
GAMBIARRA_SESSION_TOKENS_PER_HOUR=100000
GAMBIARRA_SESSION_DAILY_BUDGET=50.00

# Server host/port overrides (optional)
GAMBIARRA_SERVER_HOST=0.0.0.0
GAMBIARRA_SERVER_PORT=8765

# Client server URL override (optional)
GAMBIARRA_SERVER_URL=ws://localhost:8765
